# Makes Edifice.app self-contained and validly signed (run after each link):
#   cmake -DBUNDLE=<path/Edifice.app> -P macos_bundle_fixup.cmake
# - copies the non-system dylibs the executable links (Homebrew SDL2) into
#   Contents/Frameworks and points the executable at @executable_path/../Frameworks
# - ad-hoc signs the dylibs, then the bundle (the linker's signature predates
#   Resources/ and the install_name_tool edits, so it no longer verifies).
if(NOT BUNDLE)
  message(FATAL_ERROR "BUNDLE not set")
endif()
set(exe "${BUNDLE}/Contents/MacOS/Edifice")
set(fw "${BUNDLE}/Contents/Frameworks")

function(non_system_deps file out)
  execute_process(COMMAND otool -L "${file}" OUTPUT_VARIABLE txt RESULT_VARIABLE r)
  if(r)
    message(FATAL_ERROR "otool -L failed on ${file}")
  endif()
  string(REPLACE "\n" ";" lines "${txt}")
  set(deps)
  foreach(l ${lines})
    if(l MATCHES "^[ \t]+(/[^ ]+) \\(")
      set(d "${CMAKE_MATCH_1}")
      if(NOT d MATCHES "^(/usr/lib/|/System/)")
        list(APPEND deps "${d}")
      endif()
    endif()
  endforeach()
  set(${out} "${deps}" PARENT_SCOPE)
endfunction()

set(todo "${exe}")
set(copied)
while(todo)
  list(GET todo 0 bin)
  list(REMOVE_AT todo 0)
  non_system_deps("${bin}" deps)
  foreach(dep ${deps})
    get_filename_component(name "${dep}" NAME)
    set(dst "${fw}/${name}")
    if(NOT name IN_LIST copied)
      if(NOT EXISTS "${dep}")
        message(FATAL_ERROR "dependency not found: ${dep}")
      endif()
      file(MAKE_DIRECTORY "${fw}")
      get_filename_component(real "${dep}" REALPATH)
      file(REMOVE "${dst}")
      configure_file("${real}" "${dst}" COPYONLY)
      file(CHMOD "${dst}" PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ)
      execute_process(COMMAND install_name_tool -id "@executable_path/../Frameworks/${name}" "${dst}" ERROR_QUIET)
      list(APPEND copied "${name}")
      list(APPEND todo "${dst}")
    endif()
    if(NOT dep STREQUAL dst)   # a copied dylib's own id is not a dependency
      execute_process(COMMAND install_name_tool -change "${dep}"
        "@executable_path/../Frameworks/${name}" "${bin}" RESULT_VARIABLE r ERROR_QUIET)
    endif()
  endforeach()
endwhile()

# Drop the Homebrew LC_RPATH entries the linker added: they are not needed any more.
execute_process(COMMAND otool -l "${exe}" OUTPUT_VARIABLE txt)
string(REGEX MATCHALL "path (/[^ ]+) \\(offset" rps "${txt}")
foreach(rp ${rps})
  string(REGEX REPLACE "path (/[^ ]+) \\(offset" "\\1" rp "${rp}")
  if(NOT rp MATCHES "^(/usr/lib|/System)")
    execute_process(COMMAND install_name_tool -delete_rpath "${rp}" "${exe}" ERROR_QUIET)
  endif()
endforeach()

file(GLOB libs "${fw}/*.dylib")
foreach(l ${libs})
  execute_process(COMMAND codesign --force --sign - "${l}" RESULT_VARIABLE r)
  if(r)
    message(FATAL_ERROR "codesign failed on ${l}")
  endif()
endforeach()
execute_process(COMMAND codesign --force --sign - "${BUNDLE}" RESULT_VARIABLE r)
if(r)
  message(FATAL_ERROR "codesign failed on ${BUNDLE}")
endif()
