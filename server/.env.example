# Name or IP players use to reach this server (goes into the STUN/TURN URLs)
EDIFICE_PUBLIC_HOST=lobby.example.org
# Public IPv4 of the server for relayed traffic; leave empty to disable TURN
EDIFICE_TURN_RELAY_IP=203.0.113.10
# Must match the published UDP range in compose.yaml
EDIFICE_TURN_RELAY_PORTS=49160-49200
# Long random secret, e.g. from: openssl rand -hex 32
EDIFICE_TURN_SECRET=change-me
# 1 if a reverse proxy in front sets X-Forwarded-For (the lobby takes its
# right-most entry, the one the proxy wrote)
EDIFICE_TRUST_PROXY=0
# With several proxies in a chain: their IPs/CIDRs, comma-separated (empty: one)
EDIFICE_TRUSTED_PROXIES=
# Public URL of the API, e.g. https://lobby.example.org (empty: from each request,
# Host and X-Forwarded-Proto); gives the players wss://lobby.example.org/v1/signal
EDIFICE_PUBLIC_URL=
# Signaling over plain TCP for older games; "off" once they're all gone (then
# also remove port 10000 from compose.yaml and the firewall)
EDIFICE_SIGNAL=:10000
# Origins of the web version of the game allowed to call the API from a browser
# (CORS), comma-separated: GitHub Pages, plus a custom domain if the game has one
EDIFICE_CORS_ORIGINS=https://nicrf.github.io
# Image version: latest follows main; a release (e.g. 0.5.4) or a minor line
# (0.5, which gets its fixes) keeps the lobby as it is. GET /v1/version shows it.
EDIFICE_LOBBY_TAG=latest

# ---- the dedicated game server (optional: docker compose --profile game up -d) ----
# Image version, as EDIFICE_LOBBY_TAG
EDIFICE_SERVER_TAG=latest
# UDP port of the game (and the players' ports after it: open PORT to PORT+33)
EDIFICE_GAME_PORT=27020
EDIFICE_GAME_NAME=Edifice dedicated server
EDIFICE_GAME_MAX_PLAYERS=16
# public (listed), friends or private (joined by the game code), lan (not announced)
EDIFICE_GAME_VISIBILITY=public
# the lobby the game is announced on, by its public HTTPS address
EDIFICE_GAME_LOBBY=https://lobby.example.org
# ctf or sandbox
EDIFICE_GAME_MODE=ctf
# a saved map (maps/NAME.map in the game-data volume), empty: a random land
EDIFICE_GAME_MAP=
# console commands at start, ';'-separated (server vars): e.g. timelimit 20;capturelimit 3
EDIFICE_GAME_EXEC=
