#if defined(APSTUDIO_INVOKED) || !defined(HKDS)
IDC_HUGEKILLA MENU DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "New landscape\tCtrl-L",       ID_FILE_NEWLANDSCAPE
        MENUITEM "New sky\tCtrl-S",             ID_FILE_NEWSKY
        MENUITEM "E&xit",                       IDM_EXIT
        MENUITEM SEPARATOR
        MENUITEM "Save",                        SAVE
        MENUITEM "Load",                        LOAD
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About ...",                  IDM_ABOUT
    END
    POPUP "Multiplay"
    BEGIN
        MENUITEM "Start Server",                ID_MULTIPLAY_STARTSERVER
        MENUITEM "Join Game",                   ID_MULTIPLAY_JOINGAME
        MENUITEM "Disconnect",                  ID_MULTIPLAY_DISCONNECT
        , GRAYED
    END
END
#endif

