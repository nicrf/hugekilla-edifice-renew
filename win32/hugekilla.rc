/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDC_HUGEKILLA ACCELERATORS MOVEABLE PURE 
BEGIN
    "/",            IDM_ABOUT,              ASCII,  ALT, NOINVERT
    "?",            IDM_ABOUT,              ASCII,  ALT, NOINVERT
    "L",            ID_FILE_NEWLANDSCAPE,   VIRTKEY, CONTROL, NOINVERT
    "S",            ID_FILE_NEWSKY,         VIRTKEY, CONTROL, NOINVERT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG DISCARDABLE  22, 17, 230, 75
STYLE DS_MODALFRAME | WS_CAPTION | WS_SYSMENU
CAPTION "About"
FONT 8, "System"
BEGIN
    ICON            IDI_HUGEKILLA,IDC_MYICON,14,9,16,16
    LTEXT           "hugekilla Version 1.0",IDC_STATIC,49,10,119,8,
                    SS_NOPREFIX
    LTEXT           "Copyright (C) 1999",IDC_STATIC,49,20,119,8
    DEFPUSHBUTTON   "OK",IDOK,195,6,30,11,WS_GROUP
END

IDD_MULTIPLAY DIALOG DISCARDABLE  0, 0, 143, 114
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Multiplayer Game"
FONT 8, "MS Sans Serif"
BEGIN
    EDITTEXT        IDC_IP,7,33,75,12,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "Refresh IP",IDC_JOININTERNET,91,36,45,10
    PUSHBUTTON      "Paste IP Address",IDC_PASTE,7,17,75,11
    LISTBOX         IDC_LOCALGAMES,7,57,76,51,LBS_NOINTEGRALHEIGHT | 
                    WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Join",IDC_JOINLOCAL,91,98,45,10
    PUSHBUTTON      "Refresh",IDC_REFRESH,91,57,45,10
    LTEXT           "Local Games",IDC_STATIC,7,48,75,9
    LTEXT           "Internet Game",IDC_STATIC,7,7,75,10
END


